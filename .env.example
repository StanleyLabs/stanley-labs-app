# Supabase (required for whiteboard share/sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# tldraw license (optional)
VITE_TLDRAW_LICENSE_KEY=your-license-key

# Whiteboard sync server
VITE_SYNC_SERVER_URL=https://sync.stanleylabs.com

# Video chat signaling server
VITE_SIGNALING_SERVER_URL=https://signal.stanleylabs.com

# Optional: WebRTC ICE servers as JSON array (e.g. add TURN for strict NATs).
# If unset, default public STUN servers are used.
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
